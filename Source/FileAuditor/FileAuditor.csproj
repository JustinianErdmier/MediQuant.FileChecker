<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>FileAuditor</AssemblyName>
        <RootNamespace>FileAuditor</RootNamespace>
        <Version>1.0.0</Version>
        <Product>File Auditor</Product>
        <Company>MediQuant</Company>
        <Copyright>Copyright © 2026 MediQuant</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.22" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
        <PackageReference Include="Classic.Avalonia.Theme" Version="11.3.0.3" />
        <PackageReference Include="Classic.CommonControls.Avalonia" Version="11.3.0.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="ErrorOr" Version="2.1.1" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    </ItemGroup>
</Project>