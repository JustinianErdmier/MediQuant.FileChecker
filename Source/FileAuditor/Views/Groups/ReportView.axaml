<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ct="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
             xmlns:vm="clr-namespace:FileAuditor.ViewModels.Groups"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="230"
             x:Class="FileAuditor.Views.Groups.ReportView"
             x:DataType="vm:ReportViewModel">
    <Design.DataContext>
        <vm:ReportViewModel />
    </Design.DataContext>
    <ct:GroupBox Header="Report"
                 Margin="4,2">
        <Grid ColumnDefinitions="92,*,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="4"
              Margin="4">
            <CheckBox Grid.ColumnSpan="3"
                      Content="_Use a custom report location and file name"
                      IsChecked="{Binding Shared.UseCustomLocation}" />
            <!-- The built location's inputs are disabled, not hidden, while a custom location is used. -->
            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Spacing="4"
                        IsEnabled="{Binding Shared.IsBuilt}">
                <Grid ColumnDefinitions="92,140,*">
                    <Label Content="Pro_ject folder:"
                           Target="{Binding #ProjectFolderBox}"
                           VerticalAlignment="Center" />
                    <TextBox x:Name="ProjectFolderBox"
                             Grid.Column="1"
                             Watermark="D12345"
                             Text="{Binding Shared.ProjectFolder}" />
                </Grid>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="6">
                    <ct:GroupBox Header="Project Stage">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="14"
                                    Margin="4">
                            <RadioButton GroupName="ProjectStage"
                                         Content="Sa_mple"
                                         IsChecked="{Binding Shared.IsSampleProject}" />
                            <RadioButton GroupName="ProjectStage"
                                         Content="Fi_nal"
                                         IsChecked="{Binding Shared.IsFinalProject}" />
                        </StackPanel>
                    </ct:GroupBox>
                    <ct:GroupBox Grid.Column="1"
                                 Header="Audit Stage"
                                 IsEnabled="{Binding Shared.IsAuditStageEnabled}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="14"
                                    Margin="4">
                            <RadioButton GroupName="AuditStage"
                                         Content="Inte_rim"
                                         IsChecked="{Binding Shared.IsInterimAudit}" />
                            <RadioButton GroupName="AuditStage"
                                         Content="Fina_l"
                                         IsChecked="{Binding Shared.IsFinalAudit}" />
                        </StackPanel>
                    </ct:GroupBox>
                </Grid>
            </StackPanel>
            <Label Grid.Row="2"
                   Content="Lo_cation:"
                   Target="{Binding #LocationBox}"
                   VerticalAlignment="Center" />
            <TextBox x:Name="LocationBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding Location}"
                     IsReadOnly="{Binding Shared.IsBuilt}" />
            <Button x:Name="BrowseButton"
                    Grid.Row="2"
                    Grid.Column="2"
                    Content="_Browse..."
                    MinWidth="75"
                    MinHeight="23"
                    Margin="6,0,0,0"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding Shared.UseCustomLocation}"
                    Click="OnBrowseClick" />
            <Label Grid.Row="3"
                   Content="File nam_e:"
                   Target="{Binding #FileNameBox}"
                   VerticalAlignment="Center" />
            <TextBox x:Name="FileNameBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Text="{Binding FileName}"
                     IsReadOnly="{Binding Shared.IsBuilt}" />
            <StackPanel Grid.Row="4"
                        Grid.ColumnSpan="3"
                        Spacing="4">
                <StackPanel x:Name="GroupByPanel"
                            Orientation="Horizontal"
                            Spacing="14"
                            IsVisible="{Binding IsUnindexed}">
                    <TextBlock Text="Group file types by:"
                               VerticalAlignment="Center" />
                    <RadioButton GroupName="GroupFileTypesBy"
                                 Content="Listed type"
                                 IsChecked="{Binding GroupByListedType}" />
                    <RadioButton GroupName="GroupFileTypesBy"
                                 Content="Found extension"
                                 IsChecked="{Binding GroupByFoundExtension}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ct:GroupBox>
</UserControl>
