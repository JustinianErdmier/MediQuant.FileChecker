<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ct="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
             xmlns:vm="clr-namespace:FileAuditor.ViewModels.Groups"
             xmlns:mainVm="clr-namespace:FileAuditor.ViewModels.Main"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="170"
             x:Class="FileAuditor.Views.Groups.AuditView"
             x:DataType="vm:AuditViewModel">
    <Design.DataContext>
        <vm:AuditViewModel />
    </Design.DataContext>
    <ct:GroupBox Header="Audit"
                 Margin="4,2">
        <StackPanel Margin="4"
                    Spacing="6">
            <Grid ColumnDefinitions="80,84,70,84,82,*"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="3">
                <TextBlock Text="Total files:" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalFiles}" />
                <TextBlock Grid.Column="2"
                           Text="Missing:" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Missing}" />
                <TextBlock Grid.Column="4"
                           Text="Elapsed:" />
                <TextBlock Grid.Column="5"
                           Text="{Binding Elapsed}" />
                <TextBlock Grid.Row="1"
                           Text="Checked:" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Checked}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Unverified:" />
                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="{Binding Unverified}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="4"
                           Text="Remaining:" />
                <TextBlock Grid.Row="1"
                           Grid.Column="5"
                           Text="{Binding Remaining}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Skipped:" />
                <TextBlock Grid.Row="2"
                           Grid.Column="3"
                           Text="{Binding Skipped}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="4"
                           Text="Files/second:" />
                <TextBlock Grid.Row="2"
                           Grid.Column="5"
                           Text="{Binding FilesPerSecond}" />
            </Grid>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding Percent}"
                         ShowProgressText="False" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Content="_View Report"
                        MinWidth="75"
                        MinHeight="23"
                        HorizontalContentAlignment="Center"
                        Command="{Binding $parent[Window].((mainVm:MainWindowViewModel)DataContext).ViewReportCommand}" />
                <Button Grid.Column="2"
                        Content="St_art"
                        MinWidth="75"
                        MinHeight="23"
                        HorizontalContentAlignment="Center"
                        IsDefault="True"
                        Command="{Binding $parent[Window].((mainVm:MainWindowViewModel)DataContext).StartCommand}" />
                <Button Grid.Column="3"
                        Content="St_op"
                        MinWidth="75"
                        MinHeight="23"
                        HorizontalContentAlignment="Center"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsStopEnabled}"
                        Command="{Binding $parent[Window].((mainVm:MainWindowViewModel)DataContext).StopCommand}" />
            </Grid>
        </StackPanel>
    </ct:GroupBox>
</UserControl>
