<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:cc="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
               xmlns:vm="clr-namespace:FileAuditor.ViewModels.Main"
               xmlns:groups="clr-namespace:FileAuditor.Views.Groups"
               xmlns:tabs="clr-namespace:FileAuditor.Views.Tabs"
               mc:Ignorable="d"
               d:DesignWidth="640"
               d:DesignHeight="651"
               x:Class="FileAuditor.Views.Main.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Title="File Auditor"
               Icon="avares://FileAuditor/Assets/FileAuditor.png"
               Width="640"
               Height="651"
               CanResize="False"
               WindowStartupLocation="CenterScreen">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="O_pen project..."
                          Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Close project"
                          Command="{Binding CloseProjectCommand}" />
                <Separator />
                <MenuItem Header="St_art"
                          Command="{Binding StartCommand}"
                          HotKey="F5"
                          InputGesture="F5" />
                <MenuItem Header="St_op"
                          Command="{Binding StopCommand}"
                          HotKey="Escape"
                          InputGesture="Escape" />
                <MenuItem Header="_View Report"
                          Command="{Binding ViewReportCommand}"
                          HotKey="Ctrl+R"
                          InputGesture="Ctrl+R" />
                <Separator />
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"
                          InputGesture="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help Topics"
                          Command="{Binding HelpTopicsCommand}"
                          HotKey="F1"
                          InputGesture="F1" />
                <Separator />
                <MenuItem Header="_About File Auditor"
                          Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
        <cc:StatusBar DockPanel.Dock="Bottom">
            <cc:StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </cc:StatusBar.ItemsPanel>
            <cc:StatusBarItem DockPanel.Dock="Right"
                              Content="{Binding StatusAudit.StatusPercent}"
                              Width="60" />
            <cc:StatusBarItem Content="{Binding StatusAudit.StatusMessage}" />
        </cc:StatusBar>
        <Grid Margin="4"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="2">
            <Grid ColumnDefinitions="*,*">
                <groups:DatabaseView DataContext="{Binding Database}"
                                     IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsEditable}" />
                <groups:FileIndexTableView Grid.Column="1"
                                           DataContext="{Binding FileIndexTable}"
                                           IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsEditable}" />
            </Grid>
            <groups:ProjectSettingsView Grid.Row="1"
                                        DataContext="{Binding ProjectSettings}"
                                        IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsEditable}" />
            <TabControl Grid.Row="2"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Margin="4,2">
                <TabItem Header="Missing Files">
                    <tabs:MissingFilesTabView DataContext="{Binding MissingFiles}" />
                </TabItem>
                <TabItem Header="Unindexed Files">
                    <tabs:UnindexedFilesTabView DataContext="{Binding UnindexedFiles}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</ClassicWindow>
